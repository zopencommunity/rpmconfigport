RPM_VERSION="6.1.0"

export ZOPEN_BUILD_LINE="STABLE"

export ZOPEN_STABLE_URL="https://github.com/rpm-software-management/rpm.git"  # Specify the stable build URL (either git or tarball)
export ZOPEN_STABLE_TAG="rpm-${RPM_VERSION}-release"  # Specify the git tag for stable builds
export ZOPEN_STABLE_DEPS="cmake make pkgconfig popt lua zlib file libarchive scdoc sqlite libgcrypt bzip2 xz zstd lz4 gettext libiconv coreutils grep gzip patch quilt tar gawk quilt unzip gpg alternatives rpm:bin" # Specify the stable build dependencies.

## Required IF ZOPEN_BUILD_LINE='DEV'
export ZOPEN_DEV_URL="https://github.com/rpm-software-management/rpm.git"   # Specify the dev build URL

#export ZOPEN_EXTRA_CFLAGS="-D_POSIX_C_SOURCE=200809L" 
#export ZOPEN_EXTRA_CPPFLAGS="-D_POSIX_C_SOURCE=200809L -D__XPLAT=1"  
#export ZOPEN_SYSTEM_PREREQS="zos25"

export ZOPEN_CATEGORIES="core utilities"

export ZOPEN_SYSTEM_PREREQ=""

export ZOPEN_COMP="CLANG"
export ZOPEN_BOOTSTRAP="skip"  ## Bootstrap program to run (defaults to './bootstrap')
export ZOPEN_CONFIGURE="cmake" ## Configuration program to run (defaults to './configure')
export ZOPEN_CONFIGURE_MINIMAL="yes"
export ZOPEN_MAKE_MINIMAL="yes"
export ZOPEN_NAME="rpmconfig-${RPM_VERSION}"

zopen_check_results()
{
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"

  # Echo the following information to gauge build health
  echo "actualFailures:0"
  echo "totalTests:1"
  echo "expectedFailures:0"
  echo "expectedTotalTests:1"
}

zopen_get_version()
{
  echo $RPM_VERSION
}


export ZOPEN_CONFIGURE_OPTS="-B ../build --install-prefix \$ZOPEN_INSTALL_DIR/ -DCMAKE_INSTALL_PREFIX=\$ZOPEN_INSTALL_DIR/ -DRPM_VENDOR=ibm"
export ZOPEN_MAKE_OPTS="-C ../build"
export ZOPEN_MAKE_MINIMAL="yes"
export ZOPEN_INSTALL_OPTS="-C ../build install"

zopen_append_to_setup()
{
  cat <<'SETUP'
# Copy macros.zopen to lib/rpm/macros.d/ for RPM to find
# RPM searches lib/rpm/macros.d/ for macro files
if [ -f "${RPMCONFIG_HOME}/lib/rpm/macros.zopen" ]; then
  mkdir -p "${RPMCONFIG_HOME}/lib/rpm/macros.d"
  if [ ! -f "${RPMCONFIG_HOME}/lib/rpm/macros.d/macros.zopen" ]; then
    cp "${RPMCONFIG_HOME}/lib/rpm/macros.zopen" "${RPMCONFIG_HOME}/lib/rpm/macros.d/macros.zopen"
  fi
fi
SETUP
}

zopen_post_install() 
{
  prefix=$1
  
  # Copy macros.zopen to lib/rpm/ directory (will be packaged)
  macros_source="${ZOPEN_ROOT}/macros.zopen"
  macros_dest="$prefix/lib/rpm/macros.zopen"
  
  if [ -f "${macros_source}" ]; then
    mkdir -p "$prefix/lib/rpm"
    cp "${macros_source}" "${macros_dest}"
    echo "Copied macros.zopen to ${macros_dest}"
  else
    echo "WARNING: macros.zopen not found at ${macros_source}" >&2
  fi
}

